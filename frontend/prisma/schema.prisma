generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum UserRole {
  USER
  EMPLOYER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum CompanyStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  TEMPORARY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum EducationLevel {
  MATRIC
  INTERMEDIATE
  DIPLOMA
  BACHELOR
  MASTER
  MPHIL
  PHD
}

enum NotificationType {
  SYSTEM
  JOB
  MESSAGE
  APPLICATION
  COMPANY
}

enum NotificationStatus {
  UNREAD
  READ
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
//////////////////////////////////////////////////
// AUTHENTICATION
//////////////////////////////////////////////////

model User {

  id String @id @default(cuid())

  // Basic Information

  firstName String
  lastName String

  username String? @unique

  email String @unique
  emailVerified DateTime?

  password String

  phone String?

  image String?

  dateOfBirth DateTime?

  gender Gender?

  // Address

  country String?
  city String?
  address String?

  // Social Links

  linkedinUrl String?
  githubUrl String?
  portfolioUrl String?

  // Account

  role UserRole @default(USER)

  status UserStatus @default(ACTIVE)

  isProfileComplete Boolean @default(false)

  lastLogin DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////

  accounts Account[]

  sessions Session[]

  notifications Notification[]
  candidateProfile CandidateProfile?
  companies Company[]
  applications Application[]

savedJobs SavedJob[]
blogs Blog[]

subscriptions Subscription[]

messages Message[]
jobAlerts JobAlert[]

searchHistory SearchHistory[]

aiMatches AiJobMatch[]

adminLogs AdminLog[]
}

model Account {

  id String @id @default(cuid())

  userId String

  type String

  provider String

  providerAccountId String

  refresh_token String? @db.Text

  access_token String? @db.Text

  expires_at Int?

  token_type String?

  scope String?

  id_token String? @db.Text

  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])

}

model Session {

  id String @id @default(cuid())

  sessionToken String @unique

  userId String

  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model VerificationToken {

  identifier String

  token String @unique

  expires DateTime

  @@unique([identifier, token])

}

model Notification {

  id String @id @default(cuid())

  userId String

  title String

  message String @db.Text

  type NotificationType

  status NotificationStatus @default(UNREAD)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

}
//////////////////////////////////////////////////
// CANDIDATE
//////////////////////////////////////////////////

model CandidateProfile {

  id String @id @default(cuid())

  userId String @unique

  headline String?

  summary String? @db.Text

  currentJobTitle String?

  expectedSalary Int?

  salaryCurrency String? @default("USD")

  totalExperience Decimal? @db.Decimal(5,2)

  profileViews Int @default(0)

  resumeScore Int?

  availableForWork Boolean @default(true)

  openToRemote Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumes Resume[]

  experiences Experience[]

  educations Education[]

  skills CandidateSkill[]

}

model Resume {

  id String @id @default(cuid())

  profileId String

  title String

  fileUrl String

  fileSize Int?

  isDefault Boolean @default(false)

  atsScore Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

}

model Experience {

  id String @id @default(cuid())

  profileId String

  company String

  position String

  employmentType String?

  location String?

  startDate DateTime

  endDate DateTime?

  currentlyWorking Boolean @default(false)

  description String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

}

model Education {

  id String @id @default(cuid())

  profileId String

  institute String

  degree String

  fieldOfStudy String?

  educationLevel EducationLevel

  startYear Int?

  endYear Int?

  grade String?

  description String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

}

model CandidateSkill {

  id String @id @default(cuid())

  profileId String

  name String

  level Int @default(1)

  years Decimal? @db.Decimal(4,1)

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

}
//////////////////////////////////////////////////
// COMPANY
//////////////////////////////////////////////////

model Company {

  id String @id @default(cuid())

  ownerId String

  name String

  slug String @unique

  logo String?

  coverImage String?

  description String? @db.Text

  website String?

  email String?

  phone String?

  industry String?

  companySize CompanySize

  foundedYear Int?

  employeeCount Int?

  country String?

  city String?

  address String?

  linkedinUrl String?

  facebookUrl String?

  instagramUrl String?

  twitterUrl String?

  verified Boolean @default(false)

  status CompanyStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  jobs Job[]

}

//////////////////////////////////////////////////

model Category {

  id String @id @default(cuid())

  name String

  slug String @unique

  icon String?

  description String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  jobs Job[]

}
//////////////////////////////////////////////////
// JOBS
//////////////////////////////////////////////////

model Job {

  id String @id @default(cuid())

  companyId String

  categoryId String

  title String

  slug String @unique

  description String @db.Text

  requirements String? @db.Text

  responsibilities String? @db.Text

  benefits String? @db.Text

  education String?

  experienceLevel ExperienceLevel

  jobType JobType

  workMode WorkMode

  salaryMin Int?

  salaryMax Int?

  salaryCurrency String @default("USD")

  country String

  city String

  address String?

  vacancies Int @default(1)

  featured Boolean @default(false)

  urgent Boolean @default(false)

  status JobStatus @default(DRAFT)

  expiresAt DateTime?

  publishedAt DateTime?

  viewCount Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  applications Application[]

  savedJobs SavedJob[]
  aiMatches AiJobMatch[]

  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([country])
  @@index([city])
  @@index([featured])
  @@index([jobType])
  @@index([workMode])
}

//////////////////////////////////////////////////

model Application {

  id String @id @default(cuid())

  userId String

  jobId String

  resumeId String?

  coverLetter String? @db.Text

  status ApplicationStatus @default(APPLIED)

  appliedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])

  @@index([status])
}

//////////////////////////////////////////////////

model SavedJob {

  id String @id @default(cuid())

  userId String

  jobId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])

}
//////////////////////////////////////////////////
// BLOG
//////////////////////////////////////////////////

model Blog {

  id String @id @default(cuid())

  authorId String

  title String

  slug String @unique

  excerpt String?

  content String @db.Text

  featuredImage String?

  status BlogStatus @default(DRAFT)

  publishedAt DateTime?

  viewCount Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

}

//////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////

model Subscription {

  id String @id @default(cuid())

  userId String

  plan String

  amount Decimal @db.Decimal(10,2)

  currency String @default("USD")

  status SubscriptionStatus @default(ACTIVE)

  paymentStatus PaymentStatus @default(PENDING)

  startsAt DateTime

  expiresAt DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

//////////////////////////////////////////////////
// MESSAGE
//////////////////////////////////////////////////

model Conversation {

  id String @id @default(cuid())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  messages Message[]

}

model Message {

  id String @id @default(cuid())

  conversationId String

  senderId String

  content String @db.Text

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

}
//////////////////////////////////////////////////
// JOB ALERTS
//////////////////////////////////////////////////

model JobAlert {

  id String @id @default(cuid())

  userId String

  keyword String?

  country String?

  city String?

  jobType JobType?

  workMode WorkMode?

  enabled Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

//////////////////////////////////////////////////
// SEARCH HISTORY
//////////////////////////////////////////////////

model SearchHistory {

  id String @id @default(cuid())

  userId String

  keyword String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

//////////////////////////////////////////////////
// AI MATCH
//////////////////////////////////////////////////

model AiJobMatch {

  id String @id @default(cuid())

  userId String

  jobId String

  score Int

  reason String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

}

//////////////////////////////////////////////////
// ADMIN LOG
//////////////////////////////////////////////////

model AdminLog {

  id String @id @default(cuid())

  adminId String

  action String

  entity String?

  entityId String?

  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

}
